# Single source of truth for the version this branch is built against.
# Read by the scripts in this folder (shell syntax) and rewritten by update.sh.
UPSTREAM_TAG=v10.0.0.169
PRODUCT_VERSION=10.0.0
BUILD_NUMBER=169
